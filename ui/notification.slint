export component Notification inherits Window {
    in property <string> app-name;
    in property <string> summary;
    in property <string> body;
    callback dismissed();

    Rectangle {
        background: #1e1e2eee;
        border-radius: 8px;

        TouchArea {
            // Click anywhere on the toast to dismiss it.
            clicked => { root.dismissed(); }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            Text {
                text: app-name;
                color: #89b4fa;
                font-size: 11px;
            }
            Text {
                text: summary;
                color: #cdd6f4;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: body;
                color: #bac2de;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
}

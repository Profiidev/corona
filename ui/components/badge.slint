import { Theme } from "../theme.slint";

export enum BadgeVariant { default, secondary, destructive, outline }

export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeVariant> variant: BadgeVariant.default;

    private property <color> bg:
        root.variant == BadgeVariant.default ? Theme.primary :
        root.variant == BadgeVariant.secondary ? Theme.secondary :
        root.variant == BadgeVariant.destructive ? Theme.destructive :
        transparent;
    private property <color> fg:
        root.variant == BadgeVariant.default ? Theme.primary-foreground :
        root.variant == BadgeVariant.secondary ? Theme.secondary-foreground :
        root.variant == BadgeVariant.destructive ? Theme.destructive-foreground :
        Theme.foreground;

    border-radius: 9999px;
    background: root.bg;
    border-width: root.variant == BadgeVariant.outline ? 1px : 0px;
    border-color: Theme.border;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    min-width: i-layout.min-width;
    min-height: i-layout.min-height;

    i-layout := HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-top: 2px;
        padding-bottom: 2px;

        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.font-size-xs;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

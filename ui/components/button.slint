import { Theme } from "../theme.slint";

export enum ButtonVariant { default, destructive, outline, secondary, ghost, link }
// ponytail: `link` drops shadcn's underline — Slint's plain `Text` has no text-decoration property.
export enum ButtonSize { default, sm, lg, icon }

export component Button {
    in property <string> text;
    in property <ButtonVariant> variant: ButtonVariant.default;
    in property <ButtonSize> size: ButtonSize.default;
    in property <bool> enabled: true;
    out property <bool> has-focus: i-focus-scope.has-focus;
    out property <bool> pressed: root.enabled && i-touch-area.pressed;

    callback clicked <=> i-touch-area.clicked;

    private property <color> bg:
        root.variant == ButtonVariant.default ? Theme.primary :
        root.variant == ButtonVariant.destructive ? Theme.destructive :
        root.variant == ButtonVariant.secondary ? Theme.secondary :
        transparent;
    private property <color> fg:
        root.variant == ButtonVariant.default ? Theme.primary-foreground :
        root.variant == ButtonVariant.destructive ? Theme.destructive-foreground :
        root.variant == ButtonVariant.secondary ? Theme.secondary-foreground :
        root.variant == ButtonVariant.link ? Theme.primary :
        Theme.foreground;

    min-width: max(i-layout.min-width, root.size == ButtonSize.icon ? root.height : 0px);
    height: root.size == ButtonSize.sm ? 32px : root.size == ButtonSize.lg ? 40px : 36px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: i-focus-scope;

    states [
        disabled when !root.enabled : {
            i-background.opacity: 0.5;
        }
        pressed when root.pressed : {
            i-background.background: root.variant == ButtonVariant.ghost || root.variant == ButtonVariant.outline || root.variant == ButtonVariant.link ? Theme.accent : root.bg.darker(15%);
        }
        hover when i-touch-area.has-hover : {
            i-background.background: root.variant == ButtonVariant.ghost || root.variant == ButtonVariant.outline ? Theme.accent : root.variant == ButtonVariant.link ? transparent : root.bg.darker(8%);
        }
    ]

    i-background := Rectangle {
        border-radius: Theme.radius-md;
        background: root.bg;
        border-width: root.variant == ButtonVariant.outline ? 1px : 0px;
        border-color: Theme.border;

        animate background, border-color, opacity { duration: 150ms; }

        i-layout := HorizontalLayout {
            padding-left: root.size == ButtonSize.sm ? 12px : root.size == ButtonSize.lg ? 24px : 16px;
            padding-right: root.size == ButtonSize.sm ? 12px : root.size == ButtonSize.lg ? 24px : 16px;
            alignment: center;

            Text {
                text: root.text;
                color: root.fg;
                font-size: Theme.font-size-sm;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                animate color { duration: 150ms; }
            }
        }
    }

    i-touch-area := TouchArea {
        enabled: root.enabled;
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                i-touch-area.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus && root.enabled : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: i-background.border-radius + 2px;
        border-width: 2px;
        border-color: Theme.ring;
    }
}

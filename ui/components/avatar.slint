import { Theme } from "../theme.slint";

export component Avatar inherits Rectangle {
    in property <image> source;
    in property <string> fallback;
    in property <length> size: 40px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    clip: true;
    background: Theme.muted;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    if root.source.width > 0 && root.source.height > 0 : Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }

    if !(root.source.width > 0 && root.source.height > 0) : Text {
        text: root.fallback;
        color: Theme.muted-foreground;
        font-size: root.size * 0.4;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

import { Button } from "std-widgets.slint";
export component Panel inherits Window {
  callback clicked();
  background: #ff0fff;

  HorizontalLayout {
    alignment: space-between;
    Button {
      text: "Click Me";
      width: 100px;

      clicked => {
        clicked();
      }
    }

    TextInput {
      width: 200px;
      color: #000000;
    }
  }
}

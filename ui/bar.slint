import { Theme } from "./theme.slint";
import { Button, ButtonVariant, ButtonSize } from "./components/button.slint";
import { Toggle } from "./components/toggle.slint";
import { Separator } from "./components/separator.slint";
import { Input } from "./components/input.slint";
import { Switch } from "./components/switch.slint";
import { Progress } from "./components/progress.slint";
import { Badge, BadgeVariant } from "./components/badge.slint";
import { Avatar } from "./components/avatar.slint";
import { TooltipContent } from "./components/tooltip.slint";

export component Bar inherits Window {
    callback clicked();
    callback workspaceClicked(workspace: string);
    in property <[string]> workspaces: [];

    background: Theme.background;

    HorizontalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-3;
        alignment: space-between;

        Button {
            text: "Menu";
            variant: ButtonVariant.outline;
            size: ButtonSize.sm;

            clicked => { root.clicked(); }

            Tooltip {
                TooltipContent { text: "Open the main menu"; }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-1;

            for workspace[i] in root.workspaces: Toggle {
                text: workspace;
                size: ButtonSize.sm;

                toggled => { root.workspaceClicked(workspace); }
            }
        }

        Separator { orientation: Orientation.vertical; }

        Input {
            placeholder: "Search...";
            width: 200px;
        }

        Switch {
            text: "DND";
        }

        Progress {
            value: 0.65;
            width: 80px;
        }

        HorizontalLayout {
            spacing: Theme.space-2;

            Badge {
                text: "beta";
                variant: BadgeVariant.secondary;
            }

            Avatar {
                fallback: "CX";
                size: 28px;
            }
        }
    }
}

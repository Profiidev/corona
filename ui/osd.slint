export component Osd inherits Window {
    in property <string> label;
    in property <float> value; // 0..1

    Rectangle {
        background: #1e1e2eee;
        border-radius: 8px;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            Text {
                text: label;
                color: #cdd6f4;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 6px;
                background: #313244;
                border-radius: 3px;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, value));
                    height: parent.height;
                    background: #89b4fa;
                    border-radius: 3px;
                }
            }
        }
    }
}

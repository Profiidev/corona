+// The manager is a factory with no events of its own.
+delegate_noop!(WaylandClientStatePtr: ignore ext_session_lock_manager_v1::ExtSessionLockManagerV1);
+
+impl Dispatch<ext_session_lock_v1::ExtSessionLockV1, ()> for WaylandClientStatePtr {
+    fn event(
+        this: &mut Self,
+        _: &ext_session_lock_v1::ExtSessionLockV1,
+        event: <ext_session_lock_v1::ExtSessionLockV1 as Proxy>::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let client = this.get_client();
+        let mut state = client.borrow_mut();
+
+        match event {
+            // The session is now locked and every output is covered by our surfaces (or
+            // by the compositor's own blank, until we attach a buffer). Only now may
+            // anything be drawn.
+            ext_session_lock_v1::Event::Locked => {
+                state.session_locked = true;
+                if let Some(tx) = state.session_lock_tx.take() {
+                    tx.send(Ok(())).ok();
+                }
+            }
+            // Either the compositor refused the lock because another client holds the
+            // session, or it withdrew one it had granted. Nothing may be drawn, and the
+            // lock object must not be used again.
+            ext_session_lock_v1::Event::Finished => {
+                state.session_lock = None;
+                state.session_locked = false;
+                if let Some(tx) = state.session_lock_tx.take() {
+                    tx.send(Err(SessionLockRefusedError.into())).ok();
+                }
+            }
+            _ => {}
+        }
+    }
+}

+    /// Locks the session; see [`gpui::Platform::lock_session`]. Wayland-only — X11 has
+    /// no equivalent protocol, so it reports the lock as unsupported.
+    pub(crate) fn lock_session(&self) -> futures::channel::oneshot::Receiver<anyhow::Result<()>> {
+        match self {
+            #[cfg(feature = "wayland")]
+            DisplayConnection::Wayland(connection) => connection.lock_session(),
+            _ => {
+                let (tx, rx) = futures::channel::oneshot::channel();
+                tx.send(Err(gpui::session_lock::SessionLockNotSupportedError.into()))
+                    .ok();
+                rx
+            }
+        }
+    }
+
+    /// Releases a lock taken with [`DisplayConnection::lock_session`].
+    pub(crate) fn unlock_session(&self) {
+        #[cfg(feature = "wayland")]
+        if let DisplayConnection::Wayland(connection) = self {
+            connection.unlock_session();
+        }
+    }

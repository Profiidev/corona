+    fn lock_session(&self) -> futures::channel::oneshot::Receiver<anyhow::Result<()>> {
+        let (tx, rx) = futures::channel::oneshot::channel();
+        let mut state = self.0.borrow_mut();
+
+        let Some(manager) = state.globals.session_lock_manager.clone() else {
+            tx.send(Err(SessionLockNotSupportedError.into())).ok();
+            return rx;
+        };
+        if state.session_lock.is_some() {
+            tx.send(Ok(())).ok();
+            return rx;
+        }
+
+        state.session_lock = Some(manager.lock(&state.globals.qh, ()));
+        state.session_lock_tx = Some(tx);
+        rx
+    }
+
+    fn unlock_session(&self) {
+        let mut state = self.0.borrow_mut();
+        if let Some(lock) = state.session_lock.take() {
+            if state.session_locked {
+                // The only way out: until this is sent the compositor keeps the session
+                // locked even if this process dies.
+                lock.unlock_and_destroy();
+            } else {
+                // Asking to unlock a lock that was never confirmed is an `invalid_unlock`
+                // protocol error; such a lock can only be destroyed.
+                lock.destroy();
+            }
+        }
+        state.session_locked = false;
+        state.session_lock_tx = None;
+    }

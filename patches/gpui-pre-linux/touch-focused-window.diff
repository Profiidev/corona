+/// whether the pointer is over `window`, which stays hovered once a touch on it ends then
+fn pointer_over(state: &WaylandClientState, window: &WaylandWindowStatePtr) -> bool {
+    state
+        .mouse_focused_window
+        .as_ref()
+        .is_some_and(|focused| focused.ptr_eq(window))
+}

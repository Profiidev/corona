     let distance = quad_sdf(input.position.xy, surface_locals.bounds, surface_locals.corner_radii);
     return blend_color(vec4<f32>(sample.rgb, alpha), saturate(0.5 - distance));
 }
+
+// Erases the window below a shm surface, which the platform shows as a
+// subsurface underneath; the output alpha is how much to erase.
+@fragment
+fn fs_surface_hole(input: SurfaceVarying) -> @location(0) vec4<f32> {
+    if (any(input.clip_distances < vec4<f32>(0.0))) {
+        return vec4<f32>(0.0);
+    }
+    let distance = quad_sdf(input.position.xy, surface_locals.bounds, surface_locals.corner_radii);
+    return vec4<f32>(0.0, 0.0, 0.0, saturate(0.5 - distance));
+}

diff --git a/crates/gpui/src/platform/session_lock.rs b/crates/gpui/src/platform/session_lock.rs
--- a/crates/gpui/src/platform/session_lock.rs
+++ b/crates/gpui/src/platform/session_lock.rs
@@ -0,0 +1,13 @@
+use thiserror::Error;
+
+/// An error indicating that an action failed because the compositor doesn't support the required
+/// ext_session_lock_v1 protocol.
+#[derive(Debug, Error)]
+#[error("Compositor doesn't support ext_session_lock_v1")]
+pub struct SessionLockNotSupportedError;
+
+/// An error indicating that the compositor refused the lock, which happens when another client
+/// already holds the session.
+#[derive(Debug, Error)]
+#[error("The compositor refused the session lock")]
+pub struct SessionLockRefusedError;

+    /// Locks the session, so that the compositor shows only this application's
+    /// [`WindowKind::SessionLock`] windows until [`Platform::unlock_session`].
+    ///
+    /// Resolves once the compositor has confirmed the lock. Nothing may be drawn before
+    /// then. An error means the request was refused — another client already holds the
+    /// session, or the platform has no such concept.
+    fn lock_session(&self) -> oneshot::Receiver<anyhow::Result<()>> {
+        let (tx, rx) = oneshot::channel();
+        tx.send(Err(anyhow::anyhow!(
+            "session lock is not supported on this platform"
+        )))
+        .ok();
+        rx
+    }
+
+    /// Releases a lock taken with [`Platform::lock_session`].

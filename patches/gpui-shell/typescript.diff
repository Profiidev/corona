+//! TypeScript sources, by erasing their types.
+//!
+//! Types are overwritten with whitespace rather than removed, so every line and
+//! column in an error or a stack trace still points into the `.ts` file: QuickJS
+//! has no source maps. Syntax that would need code generated for it (an enum, a
+//! namespace, a parameter property, a decorator) is refused rather than
+//! transformed.
+
+use std::{
+    path::Path,
+    sync::{Arc, Mutex},
+};
+
+use anyhow::{Result, anyhow};
+use swc_common::{
+    BytePos, GLOBALS, SourceMap,
+    errors::{DiagnosticBuilder, Emitter, HANDLER, Handler},
+    sync::Lrc,
+};
+use swc_ts_fast_strip::{Mode, Options, operate};
+
+/// Whether `path` is TypeScript the loader strips before evaluating.
+pub(crate) fn is_typescript(path: &Path) -> bool {
+    matches!(
+        path.extension().and_then(|extension| extension.to_str()),
+        Some("ts" | "mts")
+    )
+}
+
+/// `source` with its types erased, or every reason it cannot be, each as
+/// `file:line:col: message`.
+pub(crate) fn strip_types(path: &Path, source: String) -> Result<String> {
+    let map = Lrc::new(SourceMap::default());
+    let diagnostics = Diagnostics::default();
+    let handler = Handler::with_emitter(true, false, Box::new(diagnostics.clone()));
+    let options = Options {
+        module: Some(true),
+        filename: Some(path.display().to_string()),
+        mode: Mode::StripOnly,
+        ..Default::default()
+    };
+    // swc drops a byte order mark, which would shift the first line.
+    let (bom, source) = match source.strip_prefix('\u{feff}') {
+        Some(rest) => ("\u{feff}", rest.to_owned()),
+        None => ("", source),
+    };
+    let stripped = GLOBALS.set(&Default::default(), || {
+        HANDLER.set(&handler, || {
+            operate(&map, &handler, source.clone(), options)
+        })
+    });
+    match stripped {
+        Ok(output) => Ok(bom.to_owned() + &keep_byte_widths(&source, output.code)),
+        Err(error) => {
+            let diagnostics = std::mem::take(&mut *diagnostics.0.lock().unwrap());
+            let mut message = if diagnostics.is_empty() {
+                format!("{}: {error}", path.display())
+            } else {
+                diagnostics
+                    .into_iter()
+                    .map(|(position, message)| {
+                        let location = map.lookup_char_pos(position);
+                        format!(
+                            "{}:{}:{}: {message}",
+                            path.display(),
+                            location.line,
+                            location.col.0 + 1
+                        )
+                    })
+                    .collect::<Vec<_>>()
+                    .join("\n")
+            };
+            if matches!(error.code, swc_ts_fast_strip::ErrorCode::UnsupportedSyntax) {
+                message.push_str(
+                    "\nenums, namespaces, parameter properties and decorators need a \
+                     transform; use erasable syntax",
+                );
+            }
+            Err(anyhow!(message))
+        }
+    }
+}
+
+/// `stripped` with every erased character as wide in bytes as in `source`.
+///
+/// swc blanks an erased character to as many spaces as its UTF-16 length, and
+/// QuickJS counts columns in bytes, so an erased `é` would shift every column
+/// after it on its line. Kept characters are copied as they are and erasures
+/// are ASCII, so the two walk in step: a non-ASCII source character missing
+/// from the output was erased to its UTF-16 length, padded here to its UTF-8
+/// one.
+fn keep_byte_widths(source: &str, stripped: String) -> String {
+    if stripped.len() == source.len() {
+        return stripped;
+    }
+    let mut output = String::with_capacity(source.len());
+    let mut rest = stripped.as_str();
+    for character in source.chars() {
+        let kept = character.is_ascii() || rest.starts_with(character);
+        let width = if kept {
+            character.len_utf8()
+        } else {
+            character.len_utf16()
+        };
+        // Out of step means swc changed how it erases: positions drift, but
+        // the code still runs.
+        let Some((written, tail)) = rest.split_at_checked(width) else {
+            return stripped;
+        };
+        output.push_str(written);
+        output.extend(std::iter::repeat_n(
+            ' ',
+            character.len_utf8() - written.len(),
+        ));
+        rest = tail;
+    }
+    output
+}
+
+/// The diagnostics swc reports, kept for the error instead of printed.
+#[derive(Clone, Default)]
+struct Diagnostics(Arc<Mutex<Vec<(BytePos, String)>>>);
+
+impl Emitter for Diagnostics {
+    fn emit(&mut self, diagnostic: &mut DiagnosticBuilder<'_>) {
+        let position = diagnostic
+            .span
+            .primary_span()
+            .map_or(BytePos(0), |span| span.lo);
+        self.0
+            .lock()
+            .unwrap()
+            .push((position, diagnostic.message()));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn strip(source: &str) -> Result<String> {
+        strip_types(Path::new("file.ts"), source.to_owned())
+    }
+
+    #[test]
+    fn types_become_whitespace_in_place() {
+        let source = "import type { A } from './a.ts';\n\
+                      interface Shape { width: number }\n\
+                      type Pair<T> = [T, T];\n\
+                      declare const outside: string;\n\
+                      export function area<T extends Shape>(shape: T, scale?: number): number {\n\
+                      \x20 const value = (shape as Shape).width! * (scale ?? 1);\n\
+                      \x20 return value satisfies number;\n\
+                      }\n\
+                      const label: string = 'é';\n";
+        let stripped = strip(source).expect("strips");
+
+        assert_eq!(stripped.len(), source.len());
+        assert_eq!(stripped.lines().count(), source.lines().count());
+        for (stripped, source) in stripped.lines().zip(source.lines()) {
+            assert_eq!(stripped.len(), source.len(), "{stripped:?}");
+        }
+        for erased in [
+            "import type",
+            "interface",
+            "Pair",
+            "declare",
+            "<T",
+            "as Shape",
+            "!",
+            "satisfies",
+            ": string",
+        ] {
+            assert!(!stripped.contains(erased), "{erased} in {stripped}");
+        }
+        assert!(stripped.contains("export function area"));
+        assert!(stripped.contains("const label         = 'é';"));
+    }
+
+    #[test]
+    fn an_erased_non_ascii_character_keeps_its_byte_width() {
+        let source = "type T = \"é𝒳\"; let a: \"é\" = \"é\"; const b = 1;\r\nb;\n";
+        let stripped = strip(source).expect("strips");
+
+        assert_eq!(stripped.len(), source.len());
+        assert_eq!(stripped.find("const b"), source.find("const b"));
+        assert!(
+            stripped.ends_with("let a       = \"é\"; const b = 1;\r\nb;\n"),
+            "{stripped:?}"
+        );
+    }
+
+    #[test]
+    fn malformed_input_is_an_error_not_a_panic() {
+        for source in [
+            "let a = 'unterminated;\n",
+            "const f = <T>(x: T) => x;\n",
+            "const e = <div>hi</div>;\n",
+            "let x: = 1;\n",
+            "}}}",
+            "\u{feff}",
+        ] {
+            let _ = strip(source);
+        }
+        let error = strip("let a = 1;\r\nlet b: = 2;\r\n")
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains("file.ts:2:"), "{error}");
+        let stripped = strip("\u{feff}let a: number = 1;\n").expect("a BOM strips");
+        assert_eq!(
+            stripped.len(),
+            "\u{feff}let a: number = 1;\n".len(),
+            "{stripped:?}"
+        );
+    }
+
+    #[test]
+    fn non_erasable_syntax_is_refused_with_its_position() {
+        for (source, position) in [
+            ("let a = 1;\nenum Color { Red }\n", "file.ts:2:1:"),
+            (
+                "let a = 1;\n  namespace N { export const x = 1; }\n",
+                "file.ts:2:3:",
+            ),
+            (
+                "class A {\n  constructor(private x: number) {}\n}\n",
+                "file.ts:2:23:",
+            ),
+            (
+                "function d(..._: unknown[]) {}\n@d class A {}\n",
+                "file.ts:2:1:",
+            ),
+        ] {
+            let error = strip(source).expect_err(source).to_string();
+            assert!(error.contains(position), "{source}: {error}");
+        }
+        let error = strip("enum Color { Red }").unwrap_err().to_string();
+        assert!(error.contains("use erasable syntax"), "{error}");
+    }
+}

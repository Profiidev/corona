+//! TypeScript applications: `.ts` files are loaded with their types erased.
+
+use std::path::{Path, PathBuf};
+
+use gpui::{TestAppContext, VisualTestContext};
+
+use crate::ShellRuntime;
+
+/// A fresh application directory holding `files`.
+fn application(name: &str, files: &[(&str, &str)]) -> PathBuf {
+    let root = std::env::temp_dir().join(format!(
+        "gpui-shell-typescript-{name}-{}",
+        std::process::id()
+    ));
+    let _ = std::fs::remove_dir_all(&root);
+    std::fs::create_dir_all(&root).expect("application directory");
+    for (file, source) in files {
+        std::fs::write(root.join(file), source).expect("source file");
+    }
+    root
+}
+
+/// Loads `entry` from `root` and renders it once.
+fn render(cx: &mut TestAppContext, root: &Path, entry: &str) -> String {
+    cx.update(crate::init);
+    let runtime = ShellRuntime::new_isolated().expect("runtime");
+    cx.update(|cx| runtime.set_global(cx));
+    let view_type = runtime.load_app(root, entry).expect("load");
+    let window = cx.add_window(|_, _| gpui::EmptyView);
+    let mut context = VisualTestContext::from_window(*window, cx);
+    let object = context
+        .update(|window, cx| runtime.instantiate(&view_type, window, cx))
+        .expect("instantiate");
+    context.update(|window, cx| {
+        runtime
+            .render_to_spec(&object, None, window, cx)
+            .expect("render")
+    })
+}
+
+#[gpui::test]
+fn a_typescript_entry_loads_and_renders(cx: &mut TestAppContext) {
+    let root = application(
+        "render",
+        &[(
+            "main.ts",
+            r#"import { div, View } from "gpui-kit";
+interface State { count: number }
+export default class Counter extends View {
+  state!: State;
+  init(): void { this.state = { count: 0 } satisfies State; }
+  render(_cx: unknown) { return div().child(`Count: ${this.state.count as number}`); }
+}
+"#,
+        )],
+    );
+    let tree = render(cx, &root, "main.ts");
+    assert!(tree.contains("Count: 0"), "{tree}");
+    let _ = std::fs::remove_dir_all(root);
+}
+
+#[gpui::test]

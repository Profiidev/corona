+    /// Paints `background` under the content instead of the theme's
+    /// background, like a transparent one for a window the host draws itself.
+    /// `None` goes back to the theme's.
+    pub fn set_background(&mut self, background: Option<Hsla>, cx: &mut Context<Self>) {
+        self.background = background;
+        cx.notify();
+    }
+
+    /// Whether the root fills its window, the default, or is as big as its
+    /// content, for a view the host places among others of its own.
+    pub fn set_fill(&mut self, fill: bool, cx: &mut Context<Self>) {
+        self.fill = fill;
+        cx.notify();
+    }
+
+    /// The background [`Self::set_background`] set, if any.
+    pub fn background(&self) -> Option<Hsla> {
+        self.background
+    }
+
+    /// Whether the root fills its window; see [`Self::set_fill`].
+    pub fn fills(&self) -> bool {
+        self.fill
+    }

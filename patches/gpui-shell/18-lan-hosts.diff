+/// Whether `ip` is in a private network a LAN host grant may resolve to: the
+/// private IPv4 ranges, shared address space (carrier NAT, Tailscale) and
+/// IPv6 unique local addresses. Never loopback or link-local, where the
+/// metadata endpoint lives, nor anything else reserved.
+pub(super) fn is_lan(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(ip) => {
+            let [a, b, ..] = ip.octets();
+            ip.is_private() || (a == 100 && b & 0xc0 == 64)
+        }
+        IpAddr::V6(ip) => match ip.to_ipv4_mapped() {
+            Some(ip) => is_lan(IpAddr::V4(ip)),
+            None => ip.segments()[0] & 0xfe00 == 0xfc00,
+        },
+    }

@@ -0,0 +1,209 @@
+//! The TLS client config behind `fetch` and `WebSocket`.
+//!
+//! Always the ring provider, chosen explicitly: with both ring and aws-lc-rs
+//! compiled into the tree rustls has no process default, and a config built
+//! from it panics. Without a `tls` option a server is checked against the
+//! system's roots, as reqwest does; with one, the plugin has decided to trust
+//! one certificate, or any, for a host its capabilities already grant.
+
+use std::sync::{Arc, OnceLock};
+
+use rquickjs::{Ctx, Exception, Result, Value};
+use rustls::{
+    ClientConfig, DigitallySignedStruct, RootCertStore, SignatureScheme,
+    client::danger::{HandshakeSignatureValid, ServerCertVerified, ServerCertVerifier},
+    crypto::{WebPkiSupportedAlgorithms, verify_tls12_signature, verify_tls13_signature},
+    pki_types::{CertificateDer, ServerName, UnixTime},
+};
+use sha2::Digest as _;
+
+/// The `tls` option: which certificate a server may present instead of one
+/// the system trusts.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum Trust {
+    /// Only the certificate whose DER encoding has this SHA-256.
+    Pin([u8; 32]),
+    /// Any certificate. The connection is encrypted but not authenticated.
+    Insecure,
+}
+
+/// Parses `{ pin: "sha256/<hex>" }` or `{ insecure: true }`; `call` names the
+/// option in errors.
+pub(super) fn parse<'js>(ctx: &Ctx<'js>, value: Value<'js>, call: &str) -> Result<Option<Trust>> {
+    if value.is_null() || value.is_undefined() {
+        return Ok(None);
+    }
+    let Some(object) = value.into_object() else {
+        return Err(Exception::throw_type(
+            ctx,
+            &format!("{call}.tls expects an object with pin or insecure"),
+        ));
+    };
+    for key in object.keys::<String>() {
+        let key = key?;
+        if !matches!(key.as_str(), "pin" | "insecure") {
+            return Err(Exception::throw_type(
+                ctx,
+                &format!("unknown option `{key}` for {call}.tls; expected pin or insecure"),
+            ));
+        }
+    }
+    let pin = object.get::<_, Option<String>>("pin")?;
+    let insecure = object.get::<_, Option<bool>>("insecure")?.unwrap_or(false);
+    match (pin, insecure) {
+        (Some(_), true) => Err(Exception::throw_type(
+            ctx,
+            &format!("{call}.tls takes pin or insecure, not both"),
+        )),
+        (Some(pin), false) => parse_pin(&pin)
+            .map(|pin| Some(Trust::Pin(pin)))
+            .map_err(|error| Exception::throw_type(ctx, &format!("{call}.tls.pin {error}"))),
+        (None, true) => Ok(Some(Trust::Insecure)),
+        (None, false) => Ok(None),
+    }
+}
+
+/// `sha256/` and 64 hex digits, colons allowed, as `openssl x509 -fingerprint
+/// -sha256` prints them.
+fn parse_pin(pin: &str) -> std::result::Result<[u8; 32], String> {
+    let invalid = || format!("`{pin}` must be sha256/ and 64 hex digits");
+    let hex = pin
+        .strip_prefix("sha256/")
+        .ok_or_else(invalid)?
+        .replace(':', "");
+    if hex.len() != 64 || !hex.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err(invalid());
+    }
+    let mut digest = [0; 32];
+    for (index, byte) in digest.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&hex[index * 2..index * 2 + 2], 16).map_err(|_| invalid())?;
+    }
+    Ok(digest)
+}
+
+pub(super) fn config(trust: Option<Trust>) -> std::result::Result<ClientConfig, String> {
+    let provider = Arc::new(rustls::crypto::ring::default_provider());
+    let algorithms = provider.signature_verification_algorithms;
+    let builder = ClientConfig::builder_with_provider(provider)
+        .with_safe_default_protocol_versions()
+        .map_err(|error| format!("building the TLS config failed: {error}"))?;
+    let builder = match trust {
+        None => builder.with_root_certificates(native_roots()),
+        Some(trust) => builder
+            .dangerous()
+            .with_custom_certificate_verifier(Arc::new(Verifier { trust, algorithms })),
+    };
+    Ok(builder.with_no_client_auth())
+}
+
+/// Read once: the system bundle is a few hundred certificates to parse.
+// ponytail: a root added to the system while running is seen after a restart.
+fn native_roots() -> Arc<RootCertStore> {
+    static ROOTS: OnceLock<Arc<RootCertStore>> = OnceLock::new();
+    ROOTS
+        .get_or_init(|| {
+            let mut roots = RootCertStore::empty();
+            roots.add_parsable_certificates(rustls_native_certs::load_native_certs().certs);
+            Arc::new(roots)
+        })
+        .clone()
+}
+
+/// Skips chain and name validation; the handshake signature is still checked,
+/// so the server must hold the key of the certificate it presented.
+#[derive(Debug)]
+struct Verifier {
+    trust: Trust,
+    algorithms: WebPkiSupportedAlgorithms,
+}
+
+impl ServerCertVerifier for Verifier {
+    fn verify_server_cert(
+        &self,
+        end_entity: &CertificateDer<'_>,
+        _: &[CertificateDer<'_>],
+        _: &ServerName<'_>,
+        _: &[u8],
+        _: UnixTime,
+    ) -> std::result::Result<ServerCertVerified, rustls::Error> {
+        match self.trust {
+            Trust::Pin(pin) if sha2::Sha256::digest(end_entity.as_ref()).as_slice() != pin => Err(
+                rustls::Error::General("certificate does not match the pinned sha256".to_owned()),
+            ),
+            _ => Ok(ServerCertVerified::assertion()),
+        }
+    }
+
+    fn verify_tls12_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        signature: &DigitallySignedStruct,
+    ) -> std::result::Result<HandshakeSignatureValid, rustls::Error> {
+        verify_tls12_signature(message, cert, signature, &self.algorithms)
+    }
+
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        signature: &DigitallySignedStruct,
+    ) -> std::result::Result<HandshakeSignatureValid, rustls::Error> {
+        verify_tls13_signature(message, cert, signature, &self.algorithms)
+    }
+
+    fn supported_verify_schemes(&self) -> Vec<SignatureScheme> {
+        self.algorithms.supported_schemes()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn verify(trust: Trust, cert: &[u8]) -> bool {
+        let algorithms = rustls::crypto::ring::default_provider().signature_verification_algorithms;
+        Verifier { trust, algorithms }
+            .verify_server_cert(
+                &CertificateDer::from(cert),
+                &[],
+                &ServerName::try_from("ha.local").expect("name"),
+                &[],
+                UnixTime::now(),
+            )
+            .is_ok()
+    }
+
+    #[test]
+    fn a_pin_accepts_only_the_certificate_it_names() {
+        let cert = b"not really DER, only hashed";
+        let pin = sha2::Sha256::digest(cert).into();
+        assert!(verify(Trust::Pin(pin), cert));
+        assert!(!verify(Trust::Pin(pin), b"another certificate"));
+        assert!(verify(Trust::Insecure, b"another certificate"));
+    }
+
+    #[test]
+    fn a_pin_is_sha256_and_64_hex_digits() {
+        let hex = "AB".repeat(32);
+        assert_eq!(parse_pin(&format!("sha256/{hex}")), Ok([0xab; 32]));
+        let colons = vec!["ab"; 32].join(":");
+        assert_eq!(parse_pin(&format!("sha256/{colons}")), Ok([0xab; 32]));
+        for invalid in [
+            hex.clone(),
+            format!("sha1/{hex}"),
+            format!("sha256/{}", &hex[2..]),
+            format!("sha256/{}zz", &hex[2..]),
+            format!("sha256/{}é", &hex[2..]),
+        ] {
+            assert!(parse_pin(&invalid).is_err(), "{invalid}");
+        }
+    }
+
+    #[test]
+    fn every_trust_builds_a_config() {
+        for trust in [None, Some(Trust::Insecure), Some(Trust::Pin([0; 32]))] {
+            assert!(config(trust).is_ok());
+        }
+    }
+}

+/// Sends one request on a fresh connection and returns once the headers are
+/// in. The connection lives on a current-thread runtime that only runs while
+/// a read blocks on it, so it needs no thread of its own.
+#[cfg(unix)]
+fn send_unix(
+    path: &std::path::Path,
+    url: reqwest::Url,
+    options: FetchOptions,
+) -> std::result::Result<Fetched, String> {
+    let failed = |error: &dyn std::fmt::Display| {
+        format!("fetching {url} over {} failed: {error}", path.display())
+    };
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_io()
+        .enable_time()
+        .build()
+        .map_err(|error| failed(&error))?;
+    // Timers and sockets register with the runtime when they are created.
+    let _entered = runtime.enter();
+    let timeout = options.timeout;
+    let (mut sender, connection) = runtime
+        .block_on(tokio::time::timeout(timeout, async {
+            let stream = tokio::net::UnixStream::connect(path).await?;
+            hyper::client::conn::http1::handshake(hyper_util::rt::TokioIo::new(stream))
+                .await
+                .map_err(std::io::Error::other)
+        }))
+        .map_err(|error| failed(&error))?
+        .map_err(|error| failed(&error))?;
+    runtime.spawn(connection);
+
+    let target = match url.query() {
+        Some(query) => format!("{}?{query}", url.path()),
+        None => url.path().to_owned(),
+    };
+    let authority = match (url.host_str(), url.port()) {
+        (Some(host), Some(port)) => format!("{host}:{port}"),
+        (Some(host), None) => host.to_owned(),
+        (None, _) => "localhost".to_owned(),
+    };
+    let mut request = hyper::Request::new(http_body_util::Full::new(hyper::body::Bytes::from(
+        options.body,
+    )));
+    *request.method_mut() = options.method;
+    *request.uri_mut() = target.parse().map_err(|error| failed(&error))?;
+    *request.headers_mut() = options.headers;
+    request.headers_mut().insert(
+        hyper::header::HOST,
+        hyper::header::HeaderValue::from_str(&authority).map_err(|error| failed(&error))?,
+    );
+    let response = runtime
+        .block_on(tokio::time::timeout(timeout, sender.send_request(request)))
+        .map_err(|error| failed(&error))?
+        .map_err(|error| failed(&error))?;
+    Ok(Fetched {
+        status: response.status().as_u16(),
+        url: url.to_string(),
+        body: Box::new(UnixBody {
+            runtime,
+            body: response.into_body(),
+            chunk: hyper::body::Bytes::new(),
+            timeout,
+            _sender: sender,
+        }),
     })
 }
 
+/// A unix response body as `Read`, each read bounded by the fetch timeout.
+#[cfg(unix)]
+struct UnixBody {
+    runtime: tokio::runtime::Runtime,
+    body: hyper::body::Incoming,
+    chunk: hyper::body::Bytes,
+    timeout: Duration,
+    _sender: hyper::client::conn::http1::SendRequest<http_body_util::Full<hyper::body::Bytes>>,
+}
+
+#[cfg(unix)]
+impl std::io::Read for UnixBody {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        use http_body_util::BodyExt as _;
+        let _entered = self.runtime.enter();
+        while self.chunk.is_empty() {
+            let frame = self
+                .runtime
+                .block_on(tokio::time::timeout(self.timeout, self.body.frame()));
+            match frame {
+                Err(_) => return Err(std::io::ErrorKind::TimedOut.into()),
+                Ok(None) => return Ok(0),
+                Ok(Some(Err(error))) => return Err(std::io::Error::other(error)),
+                Ok(Some(Ok(frame))) => {
+                    if let Ok(data) = frame.into_data() {
+                        self.chunk = data;
+                    }
+                }
+            }
+        }
+        let count = buf.len().min(self.chunk.len());
+        buf[..count].copy_from_slice(&self.chunk.split_to(count));
+        Ok(count)
+    }
+}
+
+/// A response whose body is still unread, from either transport.
+struct Fetched {
+    status: u16,
+    url: String,
+    body: Box<dyn std::io::Read + Send>,
+}
+
+impl From<reqwest::blocking::Response> for Fetched {
+    fn from(response: reqwest::blocking::Response) -> Self {
+        Self {
+            status: response.status().as_u16(),
+            url: response.url().to_string(),
+            body: Box::new(response),
+        }
+    }
+}

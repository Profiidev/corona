+fn fetch_unix<'js>(
+    ctx: Ctx<'js>,
+    path: std::path::PathBuf,
+    url: reqwest::Url,
+    options: FetchOptions,
+) -> Result<Promise<'js>> {
+    if !host::capabilities().may_connect_unix(&path) {
+        return Err(Exception::throw_type(
+            &ctx,
+            &format!(
+                "unix socket `{}` is not granted; add it to capabilities.network.unix",
+                path.display()
+            ),
+        ));
+    }
+    if options.stream {
+        return scheduler::blocking(&ctx, "fetch(url, options)", move || {
+            send_unix(&path, url, options).map(FetchStream)
         });
     }
     scheduler::blocking(&ctx, "fetch(url, options)", move || {
-        request(capabilities, initial, options, injected_client)

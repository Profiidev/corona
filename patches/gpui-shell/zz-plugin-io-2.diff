+        .map_err(|_| "file lock was poisoned".to_owned())?;
+    let file = file
+        .as_mut()
+        .ok_or_else(|| "the file is closed".to_owned())?;
+    body(file).map_err(|error| format!("file I/O failed: {error}"))
+}
+
+impl<'js> IntoJs<'js> for FileHandle {
+    fn into_js(self, ctx: &Ctx<'js>) -> Result<Value<'js>> {
+        let handle = Object::new(ctx.clone())?;
+        // The anchor task closes the file when the view or plugin goes away.
+        // ponytail: try_lock, so a read stuck on a FIFO cannot hang the UI; such
+        // a file closes once its last handle is collected instead.
+        let anchored = self.0.clone();
+        let (_, anchor) = scheduler::actor_cancellable::<()>(ctx, "fs.open(path)", move || {
+            if let Ok(mut file) = anchored.try_lock() {
+                file.take();
+            }
+        })?;
+        let anchor = Rc::new(Cell::new(Some(anchor)));
+
+        let file = self.0.clone();
+        handle.set(
+            "read",
+            Func::from(
+                move |ctx: Ctx<'js>, size: Opt<usize>| -> Result<Promise<'js>> {
+                    let size = size.0.unwrap_or(64 * 1024);
+                    if size > IO_LIMIT {
+                        return Err(Exception::throw_range(
+                            &ctx,
+                            &format!("file read exceeded the {IO_LIMIT} byte limit"),
+                        ));
+                    }
+                    let file = file.clone();
+                    scheduler::blocking(&ctx, "file.read(size)", move || {
+                        let mut bytes = vec![0; size];
+                        let count = with_file(&file, |file| file.read(&mut bytes))?;
+                        bytes.truncate(count);
+                        Ok(ReadChunk((count > 0 || size == 0).then_some(bytes)))
+                    })
+                },
+            ),
+        )?;
+        let file = self.0.clone();
+        handle.set(
+            "write",
+            Func::from(
+                move |ctx: Ctx<'js>, data: Value<'js>| -> Result<Promise<'js>> {
+                    let data = host::bytes_arg(&ctx, data, "file.write(data)")?;
+                    if data.len() > IO_LIMIT {
+                        return Err(Exception::throw_range(
+                            &ctx,
+                            &format!("file write exceeded the {IO_LIMIT} byte limit"),
+                        ));
+                    }
+                    let file = file.clone();
+                    scheduler::blocking(&ctx, "file.write(data)", move || {
+                        with_file(&file, |file| file.write_all(&data))
+                    })
+                },
+            ),
+        )?;
+        let file = self.0;
+        handle.set(
+            "close",
+            Func::from(move |ctx: Ctx<'js>| -> Result<Promise<'js>> {
+                if let Some(anchor) = anchor.take() {
+                    anchor.settle(Ok(()));
+                }
+                let file = file.clone();
+                scheduler::blocking(&ctx, "file.close()", move || {
+                    file.lock()
+                        .map(|mut file| drop(file.take()))
+                        .map_err(|_| "file lock was poisoned".to_owned())
+                })
+            }),
+        )?;
+        Ok(handle.into_value())
+    }
+}

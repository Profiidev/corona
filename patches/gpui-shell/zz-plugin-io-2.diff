+/// `open(path, flags)`: a handle read and written in pieces, for files too
+/// large or too live for `readFile`. Flags are "r" (default), "w", "a" or "r+".
+fn open<'js>(ctx: Ctx<'js>, path: String, flags: Opt<String>) -> Result<Promise<'js>> {
+    let flags = flags.0.unwrap_or_else(|| "r".to_owned());
+    let mut options = cap_std::fs::OpenOptions::new();
+    let access = match flags.as_str() {
+        "r" => {
+            options.read(true);
+            Access::Read
+        }
+        "w" => {
+            options.write(true).create(true).truncate(true);
+            Access::Write
+        }
+        "a" => {
+            options.append(true).create(true);
+            Access::Write
+        }
+        "r+" => {
+            host::grant(&ctx, &path, Access::Read)?;
+            options.read(true).write(true);
+            Access::Write
+        }
+        other => {
+            return Err(Exception::throw_type(
+                &ctx,
+                &format!("fs.open(path, flags) does not know `{other}`; expected r, w, a or r+"),
+            ));
+        }
+    };
+    let grant = host::grant(&ctx, &path, access)?;
+    let name = grant.describe();
+    let (dir, relative) = grant.into_parts();
+    scheduler::blocking(&ctx, "fs.open(path, flags)", move || {
+        dir.open_with(&relative, &options)
+            .map(|file| FileHandle(Arc::new(Mutex::new(Some(file.into_std())))))
+            .map_err(|error| format!("cannot open `{name}`: {error}"))
+    })
+}

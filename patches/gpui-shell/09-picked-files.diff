+    /// Makes a path the user picked readable: a file alone, a directory as a
+    /// read root.
+    // ponytail: grows with every pick until the plugin restarts.
+    pub fn grant_read(&self, path: PathBuf) {
+        // Resolved now, so a link swapped in for the pick later never moves
+        // the grant, nor turns a picked file into a directory root.
+        let Ok(path) = path.canonicalize() else {
+            return;
+        };
+        let is_dir = path.is_dir();
+        if let Ok(mut picked) = self.picked.lock() {
+            picked.push((path, is_dir));
+        }
+    }

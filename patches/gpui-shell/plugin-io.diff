+#[cfg(unix)]
+pub(crate) fn spawn(
+    command: &str,
+    args: &[String],
+    env: &[(OsString, OsString)],
+    cwd: Option<&Path>,
+    stdout: bool,
+    stderr: bool,
+) -> Result<Spawned, String> {
+    let piped = |pipe: bool| if pipe { Stdio::piped() } else { Stdio::null() };
+    let child = self::command(command, args, env, cwd)?
+        .stdin(Stdio::piped())
+        .stdout(piped(stdout))
+        .stderr(piped(stderr))
+        .spawn()
+        .map_err(|error| format!("running `{command}` failed: {error}"))?;
+    Ok(Spawned {
+        pid: child.id() as i32,
+        child,
+        exited: Arc::new(Mutex::new(false)),
+    })

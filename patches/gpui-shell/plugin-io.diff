+/// Signals a spawned child's whole process group, unless it was already reaped.
+#[cfg(unix)]
+pub(crate) fn signal_group(pid: i32, exited: &Mutex<bool>, signal: i32) {
+    let exited = exited
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    if !*exited {
+        unsafe {
+            libc::kill(-pid, signal);
+        }
+    }
+}

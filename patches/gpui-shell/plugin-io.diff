+/// Blocks until a spawned child exits, then reaps it.
+///
+/// Waits without reaping first: until the zombie is collected its pid cannot be
+/// reused, so a concurrent [`signal_group`] either reaches this group or sees
+/// `exited` and does nothing.
+#[cfg(unix)]
+pub(crate) fn wait_spawned(
+    mut child: std::process::Child,
+    pid: i32,
+    exited: &Mutex<bool>,
+) -> Result<ExitInfo, String> {
+    use std::os::unix::process::ExitStatusExt as _;
+    loop {
+        let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+        let waited = unsafe {
+            libc::waitid(
+                libc::P_PID,
+                pid as libc::id_t,
+                &mut info,
+                libc::WEXITED | libc::WNOWAIT,
+            )
+        };
+        if waited == 0 {
+            break;
+        }
+        let error = std::io::Error::last_os_error();
+        if error.kind() != std::io::ErrorKind::Interrupted {
+            return Err(format!("waiting for the child failed: {error}"));
+        }
+    }
+    let mut exited = exited
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let status = child
+        .wait()
+        .map_err(|error| format!("reaping the child failed: {error}"))?;
+    *exited = true;
+    Ok(ExitInfo {
+        code: status.code(),
+        signal: status.signal(),
+    })
+}

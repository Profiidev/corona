+/// `{ env, cwd, stdout, stderr }`, shared by `run` and `spawn`.
+#[derive(Default)]
+struct ProcessOptions {
+    env: Vec<(String, String)>,
+    cwd: Option<String>,
+    stdout: Option<bool>,
+    stderr: Option<bool>,
+}
+
+impl<'js> FromJs<'js> for ProcessOptions {
+    fn from_js(ctx: &Ctx<'js>, value: Value<'js>) -> JsResult<Self> {
+        if value.is_null() || value.is_undefined() {
+            return Ok(Self::default());
+        }
+        let Some(object) = value.into_object() else {
+            return Err(Exception::throw_type(
+                ctx,
+                "process options expect an object with env, cwd, stdout and/or stderr",
+            ));
+        };
+        for key in object.keys::<String>() {
+            let key = key?;
+            if !matches!(key.as_str(), "env" | "cwd" | "stdout" | "stderr") {
+                return Err(Exception::throw_type(
+                    ctx,
+                    &format!("unknown process option `{key}`; expected env, cwd, stdout or stderr"),
+                ));
+            }
+        }
+        let mut env = Vec::new();
+        if let Some(values) = object.get::<_, Option<Object>>("env")? {
+            for entry in values.props::<String, Value>() {
+                let (name, value) = entry?;
+                let value = String::from_js(ctx, value).map_err(|_| {
+                    Exception::throw_type(ctx, "process options.env expects string values")
+                })?;
+                env.push((name, value));
+            }
+        }
+        let stream = |name: &str| -> JsResult<Option<bool>> {
+            match object.get::<_, Option<String>>(name)?.as_deref() {
+                None => Ok(None),
+                Some("pipe") => Ok(Some(true)),
+                Some("ignore") => Ok(Some(false)),
+                Some(other) => Err(Exception::throw_type(
+                    ctx,
+                    &format!("process options.{name} `{other}` must be \"pipe\" or \"ignore\""),
+                )),
+            }
+        };
+        Ok(Self {
+            env,
+            cwd: object.get("cwd")?,
+            stdout: stream("stdout")?,
+            stderr: stream("stderr")?,
+        })
+    }
+}
+
+impl ProcessOptions {
+    /// Checks the options against the grant on the calling thread, so a denial
+    /// throws at the call site.
+    fn authorize(&self, ctx: &Ctx<'_>) -> JsResult<(Vec<(OsString, OsString)>, Option<PathBuf>)> {
+        let capabilities = host::capabilities();
+        let env = crate::process::child_env(&capabilities, self.env.clone())
+            .map_err(|error| Exception::throw_type(ctx, &error.to_string()))?;
+        let cwd = match &self.cwd {
+            None => None,
+            Some(cwd) => {
+                let path = PathBuf::from(cwd);
+                if !path.is_absolute() {
+                    return Err(Exception::throw_type(
+                        ctx,
+                        &format!("process options.cwd `{cwd}` must be an absolute path"),
+                    ));
+                }
+                capabilities
+                    .open(&path, Access::Read)
+                    .map_err(|error| Exception::throw_type(ctx, &error.to_string()))?;
+                Some(path)
+            }
+        };
+        Ok((env, cwd))
+    }
+}

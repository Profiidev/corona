+fn dropping_the_view_closes_a_socket_with_a_pending_read(cx: &mut TestAppContext) {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("TCP listener");
+    let port = listener.local_addr().expect("listener address").port();
+    let (eof, saw_eof) = mpsc::channel();
+    let server = thread::spawn(move || {
+        let (mut stream, _) = listener.accept().expect("TCP connection");
+        stream
+            .set_read_timeout(Some(Duration::from_secs(10)))
+            .expect("timeout");
+        let mut byte = [0];

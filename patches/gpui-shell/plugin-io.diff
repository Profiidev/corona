+const SPAWN_LIMITS_PROBE: &str = r#"
+import { View } from "gpui-kit";
+import { v_flex } from "gpui-base";
+import { run, spawn } from "process";
+
+export default class Probe extends View {
+  init(_props, cx) {
+    this.state = "pending";
+    const errors = [];
+    for (const call of [
+      () => run("/bin/sh", ["-c", "true"], { stdout: "pipe" }),
+      () => spawn("/bin/sh", ["-c", "true"], { shell: true }),
+      () => spawn("/bin/sh", ["-c", "true"], { env: { HOME: 1 } }),
+      () => spawn("/bin/sh", ["-c", "true"], { stderr: "inherit" }),
+      () => spawn("/bin/sh", ["-c", "true"], { cwd: "/" }),
+    ]) {
+      try { call(); errors.push("allowed"); }
+      catch (error) { errors.push(`${error.name}:${error.message}`); }
+    }
+    cx.spawn(async (cx) => {
+      // One line one byte over the 1 MiB limit, from a shell builtin.
+      const child = spawn("/bin/sh", ["-c", "printf '%01048577d' 0"]);
+      try { child.kill("SIGUSR1"); errors.push("allowed"); }
+      catch (error) { errors.push(`${error.name}:${error.message}`); }
+      try { child.write("x".repeat(1048577)); errors.push("allowed"); }
+      catch (error) { errors.push(`${error.name}:${error.message}`); }
+      try { await child.readLine(); errors.push("allowed"); }
+      catch (error) { errors.push(`rejected:${error.message}`); }
+      const status = await child.wait();
+      try { await child.write("late\n"); errors.push("allowed"); }
+      catch (error) { errors.push(`rejected:${error.message}`); }
+      this.state = `${errors.join("~")}~${status.code}`;
+      cx.notify();
+    });
+  }
+  render() { return v_flex().child(this.state); }
+}

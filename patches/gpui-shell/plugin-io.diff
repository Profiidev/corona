+const CHILD_IO_LIMIT: usize = 1024 * 1024;
+
+/// Starts a long-running command the script talks to line by line.
+///
+/// The child leads its own process group, and every promise it hands out is a
+/// task whose cancellation kills that group: when the view, the plugin or the
+/// runtime goes away, so does the child and anything it started.
+#[cfg(unix)]
+fn spawn<'js>(
+    ctx: Ctx<'js>,
+    command: String,
+    args: Opt<Vec<String>>,
+    options: Opt<ProcessOptions>,
+) -> JsResult<Object<'js>> {
+    if !host::capabilities().may_run(&command) {
+        return Err(Exception::throw_type(
+            &ctx,
+            &CapabilityError::ExecuteDenied(command).to_string(),
+        ));
+    }
+    let options = options.0.unwrap_or_default();
+    let (env, cwd) = options.authorize(&ctx)?;
+    let args = args.0.unwrap_or_default();
+    let mut spawned = crate::process::spawn(
+        &command,
+        &args,
+        &env,
+        cwd.as_deref(),
+        options.stdout.unwrap_or(true),
+        options.stderr.unwrap_or(true),
+    )
+    .map_err(|error| Exception::throw_type(&ctx, &error))?;
+
+    let pid = spawned.pid;
+    let exited = spawned.exited.clone();
+    let killer = {
+        let exited = exited.clone();
+        move || crate::process::signal_group(pid, &exited, libc::SIGKILL)
+    };
+
+    // Registered after the spawn because the hook needs the pid; a refused
+    // registration must not leave the child running unowned.
+    let (exit, done) = scheduler::actor_cancellable(&ctx, "process.spawn(command)", killer.clone())
+        .inspect_err(|_| killer())?;
+    let stdout = spawned
+        .child
+        .stdout
+        .take()
+        .map(|out| Box::new(out) as ChildOutput);
+    let stderr = spawned
+        .child
+        .stderr
+        .take()
+        .map(|err| Box::new(err) as ChildOutput);
+    let mut stdin = spawned.child.stdin.take().expect("piped stdin");
+    let child = spawned.child;
+    let waited = exited.clone();
+    std::thread::Builder::new()
+        .name("process.spawn wait".to_owned())
+        .spawn(move || done.settle(crate::process::wait_spawned(child, pid, &waited)))
+        .map_err(|error| {
+            killer();
+            Exception::throw_type(&ctx, &format!("waiting for `{command}` failed: {error}"))
+        })?;
+
+    let object = Object::new(ctx.clone())?;
+    object.set("pid", pid)?;
+    object.set(
+        "readLine",
+        line_reader(&ctx, "child.readLine()", stdout, &killer)?,
+    )?;
+    object.set(
+        "readErrLine",
+        line_reader(&ctx, "child.readErrLine()", stderr, &killer)?,
+    )?;
+
+    let writer = scheduler::serve("process.spawn stdin", move |bytes: Vec<u8>| {
+        use std::io::Write as _;
+        stdin
+            .write_all(&bytes)
+            .and_then(|()| stdin.flush())
+            .map_err(|error| format!("writing to the child failed: {error}"))
+    })
+    .map_err(|error| Exception::throw_type(&ctx, &error))?;
+    let write_killer = killer.clone();
+    object.set(
+        "write",
+        Func::from(
+            move |ctx: Ctx<'js>, data: Value<'js>| -> JsResult<Promise<'js>> {
+                let bytes = if let Some(text) = data.as_string() {
+                    text.to_string()?.into_bytes()
+                } else {
+                    TypedArray::<u8>::from_js(&ctx, data)
+                        .ok()
+                        .and_then(|bytes| bytes.as_bytes().map(<[u8]>::to_vec))
+                        .ok_or_else(|| {
+                            Exception::throw_type(
+                                &ctx,
+                                "child.write(data) expects a string or Uint8Array",
+                            )
+                        })?
+                };
+                if bytes.len() > CHILD_IO_LIMIT {
+                    return Err(Exception::throw_range(
+                        &ctx,
+                        &format!("child.write(data) exceeded the {CHILD_IO_LIMIT} byte limit"),
+                    ));
+                }
+                let (promise, done) =
+                    scheduler::actor_cancellable(&ctx, "child.write(data)", write_killer.clone())?;
+                if let Err(error) = writer.send((bytes, done)) {
+                    error
+                        .0
+                        .1
+                        .settle(Err("the child's stdin is closed".to_owned()));
+                }
+                Ok(promise)
+            },
+        ),
+    )?;
+    object.set(
+        "kill",
+        Func::from(move |ctx: Ctx<'js>, signal: Opt<String>| -> JsResult<()> {
+            let signal = match signal.0.as_deref().unwrap_or("SIGTERM") {
+                "SIGTERM" => libc::SIGTERM,
+                "SIGKILL" => libc::SIGKILL,
+                "SIGINT" => libc::SIGINT,
+                "SIGHUP" => libc::SIGHUP,
+                other => {
+                    return Err(Exception::throw_type(
+                        &ctx,
+                        &format!("child.kill(signal) does not know `{other}`; expected SIGTERM, SIGKILL, SIGINT or SIGHUP"),
+                    ));
+                }
+            };
+            crate::process::signal_group(pid, &exited, signal);
+            Ok(())
+        }),
+    )?;
+    // The exit promise stays in the JS heap: a closure over it, rather than a
+    // `Persistent` that would outlive the runtime inside a Rust closure.
+    let wait: Function = ctx.eval::<Function, _>("(p) => () => p")?.call((exit,))?;
+    object.set("wait", wait)?;
+    Ok(object)
+}

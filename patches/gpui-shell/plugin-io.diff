+#[cfg(unix)]
+pub(crate) struct Spawned {
+    pub(crate) child: std::process::Child,
+    pub(crate) pid: i32,
+    /// Set once the child is reaped, under the same lock [`signal_group`]
+    /// takes, so a signal never reaches a recycled pid.
+    pub(crate) exited: Arc<Mutex<bool>>,

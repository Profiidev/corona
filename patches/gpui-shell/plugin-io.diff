+/// One HTTP exchange on a local port: reads the request, then hands the
+/// stream to `respond`.
+fn serve_once(
+    respond: impl FnOnce(&mut std::net::TcpStream) + Send + 'static,
+) -> std::net::SocketAddr {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("HTTP listener");
+    let address = listener.local_addr().expect("listener address");
+    thread::spawn(move || {
+        let (mut stream, _) = listener.accept().expect("HTTP connection");
+        let mut request = [0; 1024];
+        let _ = stream.read(&mut request);
+        respond(&mut stream);
+    });
+    address
+}

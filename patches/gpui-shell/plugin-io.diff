+    let (runtime, view, mut context) = probe(cx, &source);
+    settle(&mut context, &view, |text| text.contains("connected"));
+    drop(view);
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    let closed = loop {
+        context.executor().advance_clock(Duration::from_millis(10));
+        context.run_until_parked();
+        match saw_eof.try_recv() {
+            Ok(closed) => break closed,
+            Err(_) if std::time::Instant::now() < deadline => {
+                thread::sleep(Duration::from_millis(5));
+            }
+            Err(error) => panic!("the server never saw the socket close: {error}"),
+        }
+    };
+    server.join().expect("TCP server");
+    assert!(closed, "the peer saw data or an error instead of EOF");
+    std::mem::forget(runtime);

+#[cfg(unix)]
+type ChildOutput = Box<dyn std::io::Read + Send>;
+
+/// `readLine`: one line per call from a dedicated reader thread, `null` at EOF
+/// or when the stream was ignored.
+#[cfg(unix)]
+fn line_reader<'js>(
+    ctx: &Ctx<'js>,
+    api: &'static str,
+    stream: Option<ChildOutput>,
+    killer: &(impl Fn() + Clone + 'static),
+) -> JsResult<Function<'js>> {
+    use std::io::{BufRead as _, BufReader, Read as _};
+
+    /// Drains what nobody reads any more, so the child never blocks on a full
+    /// pipe after the script dropped its reader.
+    struct Drain(BufReader<ChildOutput>);
+    impl Drop for Drain {
+        fn drop(&mut self) {
+            let _ = std::io::copy(&mut self.0, &mut std::io::sink());
+        }
+    }
+
+    let lines = match stream {
+        None => None,
+        Some(stream) => {
+            let mut reader = Drain(BufReader::new(stream));
+            Some(
+                scheduler::serve(api, move |()| {
+                    let mut line = Vec::new();
+                    let count = (&mut reader.0)
+                        .take(CHILD_IO_LIMIT as u64 + 1)
+                        .read_until(b'\n', &mut line)
+                        .map_err(|error| format!("reading from the child failed: {error}"))?;
+                    if count == 0 {
+                        return Ok(Line(None));
+                    }
+                    if line.last() == Some(&b'\n') {
+                        line.pop();
+                        if line.last() == Some(&b'\r') {
+                            line.pop();
+                        }
+                    } else if line.len() > CHILD_IO_LIMIT {
+                        return Err(format!(
+                            "a child output line exceeded {CHILD_IO_LIMIT} bytes"
+                        ));
+                    }
+                    Ok(Line(Some(String::from_utf8_lossy(&line).into_owned())))
+                })
+                .map_err(|error| Exception::throw_type(ctx, &error))?,
+            )
+        }
+    };
+    let killer = killer.clone();

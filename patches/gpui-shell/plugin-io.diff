+/// Pumps actor-driven promises until the rendered tree satisfies `done`.
+fn settle(
+    context: &mut VisualTestContext,
+    view: &Entity<ScriptView>,
+    done: impl Fn(&str) -> bool,
+) -> String {
+    let deadline = std::time::Instant::now() + Duration::from_secs(10);
+    loop {
+        context.run_until_parked();
+        draw(context, view);
+        let rendered = snapshot(context, view);
+        if done(&rendered) || std::time::Instant::now() >= deadline {
+            return rendered;
+        }
+        thread::sleep(Duration::from_millis(5));
+        context.executor().advance_clock(Duration::from_millis(10));
+    }
+}

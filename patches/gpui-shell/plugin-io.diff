+        if !capabilities.may_pass_env(&name) {
+            return Err(crate::capability::CapabilityError::EnvDenied(name));
+        }
+        env.retain(|(existing, _)| existing.as_os_str() != OsStr::new(&name));
+        env.push((name.into(), value.into()));
+    }

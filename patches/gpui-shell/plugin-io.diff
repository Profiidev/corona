+/// `image(source)` and `AvatarImage.new(source)`, with the source checked
+/// against the grant before it is described.
+fn image_constructor(
+    globals: &Object<'_>,
+    name: &str,
+    api: &'static str,
+    runtime: Weak<ShellRuntime>,
+    build: fn(crate::spec::ImageSpec) -> Component,
+) -> JsResult<()> {
+    globals.set(
+        name,
+        Func::from(
+            move |ctx: Ctx<'_>, source: ImageArgument| -> JsResult<SpecId> {
+                let spec = resolve_image(&host::capabilities(), api, &ctx, source)?;
+                Ok(upgrade(&runtime, &ctx)?.push_node(build(spec)))
+            },
+        ),
+    )
+}
+
+/// `image()`'s argument: a `Uint8Array` (`None` when detached) or a path.
+enum ImageArgument {
+    Bytes(Option<Vec<u8>>),
+    Path(String),
+}
+
+impl<'js> FromJs<'js> for ImageArgument {
+    fn from_js(ctx: &Ctx<'js>, value: Value<'js>) -> JsResult<Self> {
+        if let Ok(bytes) = rquickjs::TypedArray::<u8>::from_js(ctx, value.clone()) {
+            return Ok(Self::Bytes(bytes.as_bytes().map(<[u8]>::to_vec)));
+        }
+        String::from_js(ctx, value).map(Self::Path)
+    }
+}
+
+/// Where an image may come from: raster bytes, a file the grant covers, or a
+/// path under the application's own directory. Never a URL, which GPUI would
+/// fetch on its own and around the network grant.
+fn resolve_image(
+    capabilities: &crate::Capabilities,
+    api: &str,
+    ctx: &Ctx<'_>,
+    source: ImageArgument,
+) -> JsResult<crate::spec::ImageSpec> {
+    use crate::spec::ImageSpec;
+    use std::path::Component as Part;
+
+    let source = match source {
+        ImageArgument::Path(source) => source,
+        ImageArgument::Bytes(None) => {
+            return Err(Exception::throw_type(
+                ctx,
+                &format!("{api} received a detached Uint8Array"),
+            ));
+        }
+        ImageArgument::Bytes(Some(bytes)) => {
+            // SVG has no magic bytes, so it is refused here like any unknown data.
+            let format = image::guess_format(&bytes)
+            .ok()
+            .and_then(|format| gpui::ImageFormat::from_mime_type(format.to_mime_type()))
+            .filter(|format| *format != gpui::ImageFormat::Svg)
+            .ok_or_else(|| {
+                Exception::throw_type(
+                    ctx,
+                    &format!("{api} bytes are not a PNG, JPEG, WebP, GIF, BMP, TIFF, ICO or PNM image"),
+                )
+            })?;
+            return Ok(ImageSpec::Bytes(std::sync::Arc::new(
+                gpui::Image::from_bytes(format, bytes),
+            )));
+        }
+    };
+    if reqwest::Url::parse(&source).is_ok() {
+        return Err(Exception::throw_type(
+            ctx,
+            &format!(
+                "{api} does not load URLs; fetch the bytes and pass them instead: \
+                 image(new Uint8Array(await (await fetch(url)).arrayBuffer()))"
+            ),
+        ));
+    }
+    let path = Path::new(&source);
+    if path.is_absolute() {
+        capabilities
+            .open(path, crate::capability::Access::Read)
+            .map_err(|error| Exception::throw_type(ctx, &format!("{api}: {error}")))?;
+        return Ok(ImageSpec::File(path.to_path_buf()));
+    }
+    let Some(root) = capabilities.asset_root_path() else {
+        return Ok(ImageSpec::Embedded(source));
+    };
+    if !path
+        .components()
+        .all(|part| matches!(part, Part::Normal(_) | Part::CurDir))
+    {
+        return Err(Exception::throw_type(
+            ctx,
+            &format!("{api} path `{source}` must stay inside the application directory"),
+        ));
+    }
+    let joined = root.join(path);
+    // A link inside the directory must not lead out of it, dangling or not: the
+    // deepest part that is there at all, link or file, has to resolve inside.
+    let existing = joined
+        .ancestors()
+        .take_while(|part| part.starts_with(root))
+        .find(|part| part.symlink_metadata().is_ok());
+    if let Some(existing) = existing {
+        let inside = root.canonicalize().is_ok_and(|root| {
+            existing
+                .canonicalize()
+                .is_ok_and(|target| target.starts_with(root))
+        });
+        if !inside {
+            return Err(Exception::throw_type(
+                ctx,
+                &format!("{api} path `{source}` leads outside the application directory"),
+            ));
+        }
+    }
+    Ok(ImageSpec::File(joined))
+}

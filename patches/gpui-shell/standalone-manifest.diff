+reqwest = { package = "gpui-pre-reqwest", version = "=0.12.15", default-features = false, features = ["charset", "http2", "macos-system-configuration", "multipart", "rustls-tls-native-roots", "socks", "stream", "blocking"], optional = true }
 tungstenite = { version = "0.29", features = ["rustls-tls-webpki-roots", "url"], optional = true }
 

Standalone manifest: inline the gpui-kit workspace inheritance so the crate
builds as a path dependency outside its workspace.

diff --git a/crates/shell/Cargo.toml b/crates/shell/Cargo.toml
index 3ec815f..6a5244a 100644
--- a/crates/shell/Cargo.toml
+++ b/crates/shell/Cargo.toml
@@ -5,7 +5,7 @@ version = "0.7.1"
 keywords = ["desktop", "gpui", "javascript", "runtime"]
 license = "Apache-2.0"
 publish = false
-edition.workspace = true
+edition = "2024"
 repository = "https://github.com/longbridge/gpui-kit"
 homepage = "https://gpui-kit.com"
 
@@ -31,10 +31,10 @@ quickjs = [
 ]
 
 [dependencies]
-gpui.workspace = true
-gpui_platform.workspace = true
-gpui-base = { workspace = true, features = ["inspector"] }
-gpui-fps.workspace = true
+gpui = { package = "gpui-pre", version = "=0.3.8" }
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.8", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
+gpui-base = { git = "https://github.com/longbridge/gpui-kit", tag = "v0.7.1", features = ["inspector"] }
+gpui-fps = { git = "https://github.com/longbridge/gpui-kit", tag = "v0.7.1" }
 
 # Keep the bindings, runtime, and LLRT compatibility facade on the same release.

@@ -0,0 +1,180 @@
+//! Headless services: a script that runs with an `App` and no window.
+//!
+//! A service entry default-exports one function instead of a view class:
+//!
+//! ```js
+//! export default async function main(cx) {
+//!   cx.timer.every(1000, () => { /* … */ });
+//! }
+//! ```
+//!
+//! `main` receives the ambient `AsyncContext` and runs as a task owned by the
+//! service's policy, so timers, `cx.spawn`, host modules and the standard
+//! modules work as they do in a view. Window APIs have no window to act on and
+//! throw their "needs a live host call" error. Dropping the [`ServiceHandle`]
+//! cancels everything the service started.
+
+use std::{any::Any, cell::RefCell, path::Path, path::PathBuf, rc::Rc};
+
+use anyhow::{Context as _, Result};
+use gpui::{App, Task};
+
+use crate::{
+    engine::{ShellRuntime, quickjs::ViewType},
+    policy::Policy,
+    scope::{self, ScopePhase},
+    watch::{POLL_INTERVAL, SourceWatcher},
+};
+
+/// A running service. Dropping it stops the service: its tasks and timers are
+/// cancelled, pending host work is dropped and spawned processes are killed.
+#[must_use = "dropping the handle stops the service"]
+pub struct ServiceHandle {
+    // Before `runtime`: the module's persistent value must be released while
+    // the runtime is still alive.
+    service: ViewType,
+    policy: Rc<Policy>,
+    runtime: Rc<ShellRuntime>,
+}
+
+impl ShellRuntime {
+    /// Starts the service whose entry module is exactly `entry`, under `policy`.
+    ///
+    /// The entry's directory is the application root, as in
+    /// [`Self::load_entry`]. Fails when the module does not evaluate or its
+    /// default export is not a function. An error thrown by `main`, or a
+    /// rejection of the promise it returns, is logged rather than returned:
+    /// the service has started by then.
+    pub fn start_service(
+        self: &Rc<Self>,
+        entry: impl AsRef<Path>,
+        policy: Rc<Policy>,
+        cx: &mut App,
+    ) -> Result<ServiceHandle> {
+        let entry = entry.as_ref();
+        let path = entry
+            .canonicalize()
+            .with_context(|| format!("cannot read `{}`", entry.display()))?;
+        let (Some(root), Some(name)) = (path.parent(), path.file_name().and_then(|n| n.to_str()))
+        else {
+            anyhow::bail!(
+                "`{}` has no parent directory or UTF-8 file name",
+                entry.display()
+            );
+        };
+
+        let loaded = {
+            let (_scope, _) =
+                scope::enter_headless(self, None, cx, ScopePhase::Task, None, policy.clone(), None);
+            self.load_app(root, name)
+        };
+        let service = match loaded {
+            Ok(service) => service,
+            Err(error) => {
+                crate::engine::quickjs::cancel_policy_tasks(&policy);
+                return Err(error);
+            }
+        };
+
+        // Built before `main` runs, so a failure below is cleaned up by `Drop`.
+        let handle = ServiceHandle {
+            service,
+            policy,
+            runtime: self.clone(),
+        };
+        self.start_service_main(&handle.service, handle.policy.clone(), cx)
+            .with_context(|| format!("starting service `{}`", entry.display()))?;
+        Ok(handle)
+    }
+}
+
+impl Drop for ServiceHandle {
+    fn drop(&mut self) {
+        if let Some(application) = self.service.application() {
+            self.runtime
+                .release_application_generation_without_context(application);
+        }
+        crate::engine::quickjs::cancel_policy_tasks(&self.policy);
+    }
+}
+
+/// Restarts a service whenever a script source under a directory changes.
+///
+/// Dropping it stops the running instance and the watch.
+#[must_use = "dropping the watcher stops the service"]
+pub struct ServiceWatcher {
+    _running: Rc<dyn Any>,
+    _task: Task<()>,
+}
+
+impl ServiceWatcher {
+    /// Calls `start` now and again after every change to a script source under
+    /// `directory`, usually the service entry's directory.
+    ///
+    /// `start` returns whatever the host keeps for one run of the service —
+    /// typically a [`ServiceHandle`] from [`ShellRuntime::start_service`]
+    /// together with state built for that run, such as a fresh [`Policy`]. The
+    /// previous run is dropped before `start` is called again, so two instances
+    /// never overlap. A failed start, the first one too, is logged and retried
+    /// on the next save, so fixing a broken service needs no restart of the
+    /// host. Fails only when `directory` cannot be watched.
+    pub fn new<S: 'static>(
+        directory: impl Into<PathBuf>,
+        mut start: impl FnMut(&mut App) -> Result<S> + 'static,
+        cx: &mut App,
+    ) -> Result<Self> {
+        let directory = directory.into();
+        let mut watcher = SourceWatcher::new(directory.clone())?;
+        let started = start(cx)
+            .inspect_err(|error| {
+                tracing::error!("service in {} failed: {error:#}", directory.display())
+            })
+            .ok();
+        let running = Rc::new(RefCell::new(started));
+        let current = Rc::downgrade(&running);
+
+        let task = cx.spawn(async move |cx| {
+            loop {
+                cx.background_executor().timer(POLL_INTERVAL).await;
+                let (changed, scanned) = cx
+                    .background_executor()
+                    .spawn(async move {
+                        let changed = watcher.poll();
+                        (changed, watcher)
+                    })
+                    .await;
+                watcher = scanned;
+
+                let Some(current) = current.upgrade() else {
+                    break;
+                };
+                match changed {
+                    Ok(true) => {}
+                    Ok(false) => continue,
+                    Err(error) => {
+                        tracing::error!("service source watch stopped: {error:#}");
+                        break;
+                    }
+                }
+
+                // Cancel first, then start: the old instance's timers and
+                // processes must not outlive the change that replaced them.
+                current.borrow_mut().take();
+                match cx.update(|cx| start(cx)) {
+                    Ok(started) => {
+                        tracing::info!("restarted the service in {}", directory.display());
+                        *current.borrow_mut() = Some(started);
+                    }
+                    Err(error) => {
+                        tracing::error!("service in {} failed: {error:#}", directory.display())
+                    }
+                }
+            }
+        });
+
+        Ok(Self {
+            _running: running,
+            _task: task,
+        })
+    }
+}

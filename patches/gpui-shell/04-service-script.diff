@@ -1228,6 +1228,20 @@ const CONTEXT_AND_VIEW: &str = r#"  /**
   /** A concrete script view class that can be retained as a nested view. */
   export type ViewClass = new (props?: import("gpui-shell").Props) => View;
 
+  /**
+   * The entry of a headless service: default-export one instead of a view.
+   *
+   * ```js
+   * export default async function main(cx) { ... }
+   * ```
+   *
+   * It runs with no window, under the service's own grant, until the host
+   * stops it — which cancels its tasks and timers and kills the processes it

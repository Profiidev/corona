@@ -0,0 +1,389 @@
+//! Headless services: `main(cx)` with an `App` and no window.
+//!
+//! No test here opens a window. A service reports what it saw through a host
+//! module, `probe.report(text)`, because it has no render to read.
+
+use std::{
+    cell::RefCell,
+    path::{Path, PathBuf},
+    rc::Rc,
+    time::{Duration, Instant},
+};
+
+use gpui::TestAppContext;
+
+use crate::{
+    Capabilities, HostModule, HostValue, ServiceHandle, ServiceWatcher, ShellRuntime,
+    policy::Policy,
+};
+
+type Log = Rc<RefCell<Vec<String>>>;
+
+/// A policy granting `capabilities` and the `probe` module that appends to `log`.
+fn policy(capabilities: Capabilities, log: &Log) -> Rc<Policy> {
+    let log = log.clone();
+    let probe = HostModule::new("probe").function("report", move |arguments| {
+        log.borrow_mut().push(arguments.string(0)?.to_owned());
+        Ok(HostValue::Null)
+    });
+    Rc::new(
+        Policy::new()
+            .with_capabilities(capabilities)
+            .with_host_module(probe)
+            .expect("probe module"),
+    )
+}
+
+/// Writes `source` as `service.js` in a fresh directory named after `name`.
+fn entry(name: &str, source: &str) -> PathBuf {
+    let directory =
+        std::env::temp_dir().join(format!("gpui-shell-service-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&directory);
+    std::fs::create_dir_all(&directory).expect("service directory");
+    let entry = directory.join("service.js");
+    std::fs::write(&entry, source).expect("service.js");
+    entry
+}
+
+fn runtime(cx: &mut TestAppContext) -> Rc<ShellRuntime> {
+    cx.update(crate::init);
+    let runtime = ShellRuntime::new_isolated().expect("runtime");
+    cx.update(|cx| runtime.set_global(cx));
+    runtime
+}
+
+fn start(
+    cx: &mut TestAppContext,
+    runtime: &Rc<ShellRuntime>,
+    capabilities: Capabilities,
+    name: &str,
+    source: &str,
+) -> (anyhow::Result<ServiceHandle>, Log) {
+    let log = Log::default();
+    let entry = entry(name, source);
+    let policy = policy(capabilities, &log);
+    let started = cx.update(|cx| runtime.start_service(&entry, policy, cx));
+    (started, log)
+}
+
+/// Pumps timers and actor-driven promises until `done` holds or ten seconds pass.
+fn settle(cx: &mut TestAppContext, log: &Log, done: impl Fn(&[String]) -> bool) -> Vec<String> {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        cx.run_until_parked();
+        let seen = log.borrow().clone();
+        if done(&seen) || Instant::now() >= deadline {
+            return seen;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+        cx.executor().advance_clock(Duration::from_millis(10));
+    }
+}
+
+fn count(log: &[String], prefix: &str) -> usize {
+    log.iter().filter(|line| line.starts_with(prefix)).count()
+}
+
+#[gpui::test]
+fn main_runs_and_its_sleeps_and_timers_resume(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let (service, log) = start(
+        cx,
+        &runtime,
+        Capabilities::new(),
+        "resume",
+        r#"
+import { report } from "probe";
+export default async function main(cx) {
+  report("started");
+  await cx.sleep(20);
+  report("slept");
+  let ticks = 0;
+  cx.timer.every(10, () => report(`tick:${++ticks}`));
+}
+"#,
+    );
+    let _service = service.expect("start");
+    let seen = settle(cx, &log, |log| count(log, "tick:") >= 2);
+    assert_eq!(seen[..2], ["started", "slept"], "{seen:?}");
+    assert!(count(&seen, "tick:") >= 2, "{seen:?}");
+}
+
+#[gpui::test]
+fn an_async_standard_module_resolves(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let data = entry("fs-data", "").with_file_name("data.txt");
+    std::fs::write(&data, "hello").expect("data.txt");
+    let directory = data.parent().expect("parent").to_path_buf();
+    let source = r#"
+import { report } from "probe";
+import * as fs from "fs/promises";
+export default async function main() {
+  report(`read:${await fs.readFile("__PATH__", "utf8")}`);
+}
+"#
+    .replace("__PATH__", &data.to_string_lossy());
+    let (service, log) = start(
+        cx,
+        &runtime,
+        Capabilities::new().read_roots([directory]),
+        "fs",
+        &source,
+    );
+    let _service = service.expect("start");
+    let seen = settle(cx, &log, |log| !log.is_empty());
+    assert_eq!(seen, ["read:hello"]);
+}
+
+#[gpui::test]
+fn capabilities_are_enforced(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let (service, log) = start(
+        cx,
+        &runtime,
+        Capabilities::new(),
+        "denied",
+        r#"
+import { report } from "probe";
+import * as fs from "fs/promises";
+import process from "process";
+export default async function main() {
+  try { await fs.readFile("/etc/hostname", "utf8"); report("fs:allowed"); }
+  catch (error) { report("fs:denied"); }
+  try { await process.run("/bin/sh", ["-c", "true"]); report("exec:allowed"); }
+  catch (error) { report("exec:denied"); }
+}
+"#,
+    );
+    let _service = service.expect("start");
+    let seen = settle(cx, &log, |log| log.len() >= 2);
+    assert_eq!(seen, ["fs:denied", "exec:denied"]);
+}
+
+#[gpui::test]
+fn a_default_export_that_is_not_a_function_is_refused(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let (service, _) = start(
+        cx,
+        &runtime,
+        Capabilities::new(),
+        "object",
+        "export default { main() {} };",
+    );
+    let error = format!("{:#}", service.err().expect("an object is not a service"));
+    assert!(
+        error.contains("must `export default` a function"),
+        "{error}"
+    );
+}
+
+#[gpui::test]
+fn a_failing_main_is_logged_not_fatal(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let (thrown, _) = start(
+        cx,
+        &runtime,
+        Capabilities::new(),
+        "thrown",
+        r#"export default function main() { throw new Error("boom"); }"#,
+    );
+    let (rejected, _) = start(
+        cx,
+        &runtime,
+        Capabilities::new(),
+        "rejected",
+        r#"export default async function main(cx) { await cx.sleep(1); throw new Error("boom"); }"#,
+    );
+    let (_thrown, _rejected) = (thrown.expect("thrown"), rejected.expect("rejected"));
+    cx.executor().advance_clock(Duration::from_millis(10));
+    cx.run_until_parked();
+
+    // The runtime still serves the next service.
+    let (service, log) = start(
+        cx,
+        &runtime,
+        Capabilities::new(),
+        "after-failure",
+        r#"import { report } from "probe"; export default function main() { report("ok"); }"#,
+    );
+    let _service = service.expect("start");
+    assert_eq!(settle(cx, &log, |log| !log.is_empty()), ["ok"]);
+}
+
+#[gpui::test]
+fn window_apis_need_a_live_host_call(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let (service, log) = start(
+        cx,
+        &runtime,
+        Capabilities::new(),
+        "window",
+        r#"
+import { report } from "probe";
+function probe(stage) {
+  try { window.viewport_size(); report(`${stage}:allowed`); }
+  catch (error) { report(`${stage}:${error.message}`); }
+}
+export default async function main(cx) {
+  probe("main");
+  await cx.sleep(1);
+  probe("resumed");
+}
+"#,
+    );
+    let _service = service.expect("start");
+    let seen = settle(cx, &log, |log| log.len() >= 2);
+    assert_eq!(seen.len(), 2, "{seen:?}");
+    for line in &seen {
+        assert!(line.contains("needs a live host call"), "{seen:?}");
+    }
+}
+
+#[cfg(unix)]
+#[gpui::test]
+fn dropping_the_handle_cancels_timers_and_kills_spawned_processes(cx: &mut TestAppContext) {
+    use crate::ExecuteGrant;
+
+    let runtime = runtime(cx);
+    let (service, log) = start(
+        cx,
+        &runtime,
+        Capabilities::new().execute(ExecuteGrant::Allowed(vec!["/bin/sh".to_owned()])),
+        "drop",
+        r#"
+import { report } from "probe";
+import { spawn } from "process";
+export default async function main(cx) {
+  // A grandchild in the child's process group, made of shell builtins only.
+  // Held, or collecting it would close stdin and end both `read`s on their own.
+  const child = (globalThis.child = spawn("/bin/sh", [
+    "-c",
+    "exec 3<&0; (read x <&3) & echo $!; read y",
+  ]));
+  const grandchild = await child.readLine();
+  report(`pids:${child.pid}:${grandchild}`);
+  cx.timer.every(10, () => report("tick"));
+}
+"#,
+    );
+    let service = service.expect("start");
+    let seen = settle(cx, &log, |log| count(log, "tick") >= 1);
+    let pids: Vec<i32> = seen
+        .iter()
+        .find_map(|line| line.strip_prefix("pids:"))
+        .expect("the pids")
+        .split(':')
+        .map(|pid| pid.trim().parse().expect("a pid"))
+        .collect();
+    assert!(pids.iter().all(|&pid| alive(pid)), "{seen:?}");
+
+    drop(service);
+    let ticks = count(&log.borrow(), "tick");
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while pids.iter().any(|&pid| alive(pid)) {
+        assert!(Instant::now() < deadline, "a process outlived its service");
+        cx.executor().advance_clock(Duration::from_millis(10));
+        cx.run_until_parked();
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert_eq!(
+        count(&log.borrow(), "tick"),
+        ticks,
+        "the timer outlived its service"
+    );
+}
+
+#[cfg(unix)]
+fn alive(pid: i32) -> bool {
+    std::fs::read_to_string(format!("/proc/{pid}/stat")).is_ok_and(|stat| !stat.contains(") Z "))
+}
+
+#[gpui::test]
+fn a_source_change_restarts_the_service(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let source = |name: &str| {
+        format!(
+            r#"import {{ report }} from "probe";
+export default function main(cx) {{ cx.timer.every(10, () => report("{name}")); }}
+"#
+        )
+    };
+    let entry = entry("reload", &source("old"));
+    let log = Log::default();
+    let starts = Rc::new(RefCell::new(0));
+    let directory = entry.parent().map(Path::to_path_buf).expect("parent");
+    let watcher = {
+        let (runtime, entry, log, starts) =
+            (runtime.clone(), entry.clone(), log.clone(), starts.clone());
+        cx.update(|cx| {
+            ServiceWatcher::new(
+                directory,
+                move |cx| {
+                    *starts.borrow_mut() += 1;
+                    runtime.start_service(&entry, policy(Capabilities::new(), &log), cx)
+                },
+                cx,
+            )
+        })
+        .expect("watch")
+    };
+    settle(cx, &log, |log| count(log, "old") >= 1);
+
+    // Older than the write that follows, so the stamp moves.
+    std::thread::sleep(Duration::from_millis(20));
+    std::fs::write(&entry, source("new")).expect("rewrite");
+    // The poll runs on the executor's clock and the debounce on the wall's.
+    for _ in 0..2 {
+        cx.executor().advance_clock(crate::watch::POLL_INTERVAL * 2);
+        cx.run_until_parked();
+        std::thread::sleep(Duration::from_millis(250));
+    }
+    settle(cx, &log, |log| count(log, "new") >= 1);
+    assert_eq!(*starts.borrow(), 2);
+
+    let old = count(&log.borrow(), "old");
+    let seen = settle(cx, &log, |log| count(log, "new") >= 3);
+    assert_eq!(count(&seen, "old"), old, "the old instance kept ticking");
+
+    drop(watcher);
+    let new = count(&log.borrow(), "new");
+    cx.executor().advance_clock(Duration::from_millis(100));
+    cx.run_until_parked();
+    assert_eq!(
+        count(&log.borrow(), "new"),
+        new,
+        "the service outlived its watcher"
+    );
+}
+
+#[gpui::test]
+fn a_service_that_fails_to_start_starts_once_fixed(cx: &mut TestAppContext) {
+    let runtime = runtime(cx);
+    let entry = entry("broken", "export default 1;");
+    let log = Log::default();
+    let directory = entry.parent().map(Path::to_path_buf).expect("parent");
+    let _watcher = {
+        let (runtime, entry, log) = (runtime.clone(), entry.clone(), log.clone());
+        cx.update(|cx| {
+            ServiceWatcher::new(
+                directory,
+                move |cx| runtime.start_service(&entry, policy(Capabilities::new(), &log), cx),
+                cx,
+            )
+        })
+        .expect("a failed start is retried, not returned")
+    };
+
+    std::thread::sleep(Duration::from_millis(20));
+    std::fs::write(
+        &entry,
+        r#"import { report } from "probe"; export default function main() { report("fixed"); }"#,
+    )
+    .expect("rewrite");
+    for _ in 0..2 {
+        cx.executor().advance_clock(crate::watch::POLL_INTERVAL * 2);
+        cx.run_until_parked();
+        std::thread::sleep(Duration::from_millis(250));
+    }
+    assert_eq!(settle(cx, &log, |log| !log.is_empty()), ["fixed"]);
+}

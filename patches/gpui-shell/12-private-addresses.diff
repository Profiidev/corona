+/// Whether `ip` is on the public internet, which is all a granted host name
+/// may resolve to: a host whose DNS answers with a private address (rebinding,
+/// or a name pointed at the cloud metadata endpoint) would otherwise turn a
+/// grant for one public server into one for the local network.
+pub(super) fn is_public(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(ip) => {
+            let [a, b, ..] = ip.octets();
+            !(ip.is_private()
+                || ip.is_loopback()
+                || ip.is_link_local()
+                || ip.is_multicast()
+                || a == 0
+                || a >= 240
+                || (a == 100 && b & 0xc0 == 64))
+        }
+        IpAddr::V6(ip) => match ip.to_ipv4_mapped() {
+            Some(ip) => is_public(IpAddr::V4(ip)),
+            None => {
+                let first = ip.segments()[0];
+                !(ip.is_unspecified()
+                    || ip.is_loopback()
+                    || ip.is_multicast()
+                    || first & 0xfe00 == 0xfc00
+                    || first & 0xffc0 == 0xfe80)
+            }
+        },
+    }
+}
+
+/// The resolved addresses `host` may connect to. A literal IP was granted as
+/// exactly that address; `localhost` may reach loopback; any other name only
+/// public addresses. A private address needs a literal-IP grant.
+pub(super) fn reachable(
+    host: &str,
+    addresses: impl IntoIterator<Item = SocketAddr>,
+) -> Result<Vec<SocketAddr>, String> {
+    let literal = host
+        .trim_start_matches('[')
+        .trim_end_matches(']')
+        .parse::<IpAddr>()
+        .is_ok();
+    let localhost = host.eq_ignore_ascii_case("localhost");
+    let addresses: Vec<SocketAddr> = addresses.into_iter().collect();
+    let resolved = addresses.len();
+    let allowed: Vec<SocketAddr> = addresses
+        .into_iter()
+        .filter(|address| {
+            literal
+                || if localhost {
+                    address.ip().is_loopback()
+                } else {
+                    is_public(address.ip())
+                }
+        })
+        .collect();
+    if allowed.is_empty() && resolved > 0 {
+        return Err(format!(
+            "`{host}` resolved only to private or reserved addresses; grant the address itself as a literal IP to reach it"
+        ));
+    }
+    Ok(allowed)
+}

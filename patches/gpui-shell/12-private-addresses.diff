+
+/// System DNS, filtered by `connect::reachable`, so a granted name cannot be
+/// rebound to a private address. IP-literal URLs never reach a resolver; they
+/// pass `authorize_request` only when granted literally. A proxy resolves on
+/// its own side and is not covered.
+struct PublicResolver;
+
+impl reqwest::dns::Resolve for PublicResolver {
+    fn resolve(&self, name: reqwest::dns::Name) -> reqwest::dns::Resolving {
+        Box::pin(async move {
+            let host = name.as_str();
+            let addresses = tokio::net::lookup_host((host, 0)).await?;
+            let addresses = super::connect::reachable(host, addresses)?;
+            Ok(Box::new(addresses.into_iter()) as reqwest::dns::Addrs)
+        })
+    }
 }
 
